{
  "schemaVersion": 1,
  "id": "fresh-armor-bar",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "Replaces the vanilla armor bar with a custom texture-based HUD!",
  "authors": [
    "ZeroXXII"
  ],
  "contact": {
    "sources": "https://github.com/ZeroXX11/Fresh_Armor_Bar"
  },
  "license": "LGPL-3.0-only",
  "icon": "icon.png",
  "environment": "client",
  "entrypoints": {
    "modmenu": [
      "com.fresharmorbar.client.config.FreshArmorBarModMenu"
    ]
  },
  "mixins": [
    "fresh-armor-bar.client.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "__minecraft_dependency__",
    "java": ">=${java_version}"
  },
  "suggests": {
    "modmenu": "*"
  }
}
